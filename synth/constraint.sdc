create_clock -name clk -period 5.0 [get_ports clk]

set_clock_uncertainty  0.15 [get_clocks clk]
set_clock_transition   0.08 [get_clocks clk]

set_input_delay  -clock clk -max 1.00 [get_ports {rst_n}]
set_input_delay  -clock clk -min 0.15 [get_ports {rst_n}]
set_input_delay  -clock clk -max 1.00 [get_ports {port_in[*]}]
set_input_delay  -clock clk -min 0.15 [get_ports {port_in[*]}]
set_input_delay  -clock clk -max 1.00 [get_ports {opt_pins[*]}]
set_input_delay  -clock clk -min 0.15 [get_ports {opt_pins[*]}]

set_output_delay -clock clk -max 1.00 [get_ports {port_out[*]}]
set_output_delay -clock clk -min 0.15 [get_ports {port_out[*]}]
set_output_delay -clock clk -max 1.00 [get_ports {flags_out[*]}]
set_output_delay -clock clk -min 0.15 [get_ports {flags_out[*]}]
set_output_delay -clock clk -max 1.00 [get_ports {pc_out[*]}]
set_output_delay -clock clk -min 0.15 [get_ports {pc_out[*]}]
set_output_delay -clock clk -max 1.00 [get_ports {wb_data_out[*]}]
set_output_delay -clock clk -min 0.15 [get_ports {wb_data_out[*]}]
set_output_delay -clock clk -max 1.00 [get_ports {wb_rd_out[*]}]
set_output_delay -clock clk -min 0.15 [get_ports {wb_rd_out[*]}]
set_output_delay -clock clk -max 1.00 [get_ports {wb_we_out}]
set_output_delay -clock clk -min 0.15 [get_ports {wb_we_out}]
set_output_delay -clock clk -max 1.00 [get_ports {branch_taken_out}]
set_output_delay -clock clk -min 0.15 [get_ports {branch_taken_out}]
set_output_delay -clock clk -max 1.00 [get_ports {flush_active_out}]
set_output_delay -clock clk -min 0.15 [get_ports {flush_active_out}]

set_driving_cell -lib_cell BUF_X2 [all_inputs]
set_load 0.02 [all_outputs]
